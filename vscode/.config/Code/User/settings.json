{
    "sync.gist": "026e2e9d874f984df5e9cad24215f13e",

    "editor.fontFamily": "'DejaVu Sans Mono','JetBrainsMono Nerd Font', Twemoji, 'Source Han Sans', 'monospace', monospace",
    "editor.fontWeight": "normal",
    "editor.fontSize": 14,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.rulers": [80,100],
    "editor.suggestSelection": "first",

    // 控制编辑器是否应自动设置粘贴内容的格式。格式化程序必须可用并且能设置文档中某一范围的格式。
    "editor.formatOnPaste": false,
    // 保存时设置文件的格式。格式化程序必须可用，不能自动保存文件，并且不能关闭编辑器。
    "editor.formatOnSave": false,
    // 在保存时格式化操作的超时时间。为 formatOnSave 命令指定时间限制 (单位: 毫秒)。运行超过设定时间的命令将被取消。
    // "editor.formatOnSaveTimeout": 750,

    "files.autoSave": "afterDelay",
    "files.trimTrailingWhitespace": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.DS_Store": true,
        "**/.idea": true
    },

    // https://code.visualstudio.com/docs/java/java-project#_configure-runtime-for-projects
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-1.8",
            "path": "~/bin/java/jdk1.8.0_212",
            "sources" : "~/bin/java/jdk1.8.0_212/src.zip",
            "javadoc" : "https://docs.oracle.com/en/java/javase/1.8/docs/api"
        },
        {
            "name": "JavaSE-17",
            "path": "~/bin/java/jdk-17.0.6",
            "sources" : "~/bin/java/jdk-17.0.6/lib/src.zip",
            "javadoc" : "https://docs.oracle.com/en/java/javase/17/docs/api"
        },
        {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/java-21-openjdk",
            "sources" : "",
            "javadoc" : "https://docs.oracle.com/en/java/javase/21/docs/api",
            "default": true
        },
        {
            "name": "JavaSE-25",
            "path": "/usr/lib/jvm/java-25-openjdk",
            "sources" : "",
            "javadoc" : "https://docs.oracle.com/en/java/javase/25/docs/api"
        }
    ],
    "java.jdt.ls.java.home": "/usr/lib/jvm/java-25-openjdk",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx1G -Xms100m --add-opens java.base/jdk.internal.misc=ALL-UNNAMED ",
    "java.project.importOnFirstTimeStartup": "automatic",
    "java.project.resourceFilters": [
        "node_modules",
        ".git"
    ],
    "java.import.maven.enabled": true,
    "java.configuration.maven.userSettings": "~/.m2/settings.xml",
    "maven.executable.path": "~/bin/java/apache-maven-3.9.0/bin/mvn",
    "maven.excludedFolders": [
        "**/.*",
        "**/node_modules",
        "**/target",
        "**/bin"
    ],

    "python.languageServer": "Pylance",

    // Python代码格式化工具，可选'autopep8'、'black'或'yapf'.
    "python.formatting.provider": "black",
    "python.formatting.blackPath": "~/.local/bin/black",

    // 默认不使用flake8对Python文件进行静态检查
    "python.linting.flake8Enabled": false,
    // 默认不使用mypy对Python文件进行静态检查
    "python.linting.mypyEnabled": false,
    // 默认不使用pep8对Python文件进行静态检查
    // "python.linting.pycodestyleEnabled": false,
    // 默认不使用prospector对Python文件进行静态检查
    "python.linting.prospectorEnabled": false,
    // 默认不使用pydocstyle对Python文件进行静态检查
    "python.linting.pydocstyleEnabled": false,
    // 默认不使用pylama对Python文件进行静态检查
    "python.linting.pylamaEnabled": false,
    // 默认使用pylint对Python文件进行静态检查
    "python.linting.pylintEnabled": true,
    "python.linting.enabled": true,

    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",

    "rsp-ui.enableStartServerOnActivation": [
        {
            "id": "redhat.vscode-community-server-connector",
            "name": "Community Server Connector",
            "startOnActivation": true
        }
    ],
    "workbench.colorTheme": "Solarized Light",
    "workbench.iconTheme": "vscode-icons",
    "workbench.editorAssociations": {
        "0": {
            "viewType": "jupyter.notebook.ipynb",
            "filenamePattern": "*.ipynb"
        },
        "*.java": "default"
    },

    "dashboard.projectData": null,
    "kite.showWelcomeNotificationOnStartup": false,

    "explorer.confirmDelete": false,
    "redhat.telemetry.enabled": true,

    "cSpell.enableFiletypes": [
        "python"
    ],

    "sonarlint.pathToNodeExecutable": "~/.nvm/versions/node/v24.12.0/bin/node",
    "[java]": {
        "editor.defaultFormatter": "redhat.java"
    },
    "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",
    "python.analysis.typeCheckingMode": "strict",
    "chat.disableAIFeatures": true,
    "workbench.editor.wrapTabs": true,
    "wakatime.apiKey": "e2bb6ca2-cb6f-4e4d-8d17-d01562aa43af",
    "wakatime.apiUrl": "https://wakapi.einverne.info/api"
}
