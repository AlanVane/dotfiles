#基础设置 {{{
[init]
    defaultBranch = main

[core]
    #{{ @See https://p3terx.com/archives/how-to-choose-crlf-lf.html
    autocrlf = input
    safecrlf = true
    #}}

    editor = nvim

    # Use custom `.gitignore` and `.gitattributes`
    excludesfile = ~/.config/git/ignore
    attributesfile = ~/.config/git/gitattributes

    # Treat spaces before tabs and all kinds of trailing whitespace as an error
    # [default] trailing-space: looks for spaces at the end of a line
    # [default] space-before-tab: looks for spaces before tabs at the beginning of a line
    whitespace = space-before-tab,-indent-with-non-tab,trailing-space

    # Speed up commands involving untracked files such as `git status`.
    # https://git-scm.com/docs/git-update-index#_untracked_cache
    untrackedCache = true

    # 解决中文文件名称在这些Git命令输出中的显示问题
    quotepath = false

    pager = "{                                                       \
    COLUMNS=$(tput cols 2>/dev/null || echo 80)                      \
    if [ $COLUMNS -ge 80 ] && [ -z $FZF_PREVIEW_COLUMNS ]; then      \
        pager_width=$(($COLUMNS-4));                                 \
        delta --side-by-side -w $pager_width;                        \
    elif [ $COLUMNS -ge 160 ] && [ ! -z $FZF_PREVIEW_COLUMNS ]; then \
        delta --side-by-side -w $FZF_PREVIEW_COLUMNS;                \
    else                                                             \
        delta;                                                       \
    fi                                                               \
}"

# {{{ delta配置 用于查看diff
[delta]
    # colors/styles
    dark = true      # or light = true, or omit for auto-detection
    syntax-theme = "TwoDark"
    # 35% green 65% base
    plus-emph-style = bold syntax "#51655a"
    # 35% red 65% base
    minus-emph-style = bold syntax "#6a485a"
    # 20% green 80% base
    plus-style = syntax "#3e4b4c"
    # 20% red 80% base
    minus-style = syntax "#4c3a4c"
    navigate = true  # use n and N to move between diff sections
    # Line numbers
    line-numbers = true
    # Side-by-side view
    side-by-side = true
    # named groups of settings
    features = unobtrusive-line-numbers decorations
    whitespace-error-style = 22 reverse
    # Hyperlinks
    hyperlinks = true
    hyperlinks-file-link-format = "vscode://file/{path}:{line}"
    # hyperlinks-file-link-format = "idea://open?file={path}&line={line}"
    # hyperlinks-file-link-format = "pycharm://open?file={path}&line={line}"

[delta "unobtrusive-line-numbers"]
    line-numbers = true
    line-numbers-minus-style = bold "#ed8796"
    line-numbers-zero-style = "#6e738d"
    line-numbers-plus-style = bold "#a6da95"
    line-numbers-left-format = "{nm:>4}┊"
    line-numbers-right-format = "{np:>4}│"
    line-numbers-left-style = "#6e738d"
    line-numbers-right-style = "#6e738d"

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = "#cad3f5"
    file-decoration-style = none
    hunk-header-decoration-style = "#6e738d" box ul
    hunk-header-file-style = bold
    hunk-header-line-number-style = bold "#a5adcb"

# }}}

[interactive]
    diffFilter = delta --color-only

[difftool "difftastic"]
    # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"
[difftool]
    # Run the difftool immediately, don't ask 'are you sure' each time.
    prompt = false
    trustExitCode = true
[diff]
    # Set difftastic as the default difftool, so we don't need to specify
    # `-t difftastic` every time.
    tool = difftastic
    # 移动的行特别显示
    colorMoved = default

[pager]
    # Use a pager if the difftool output is larger than one screenful,
    # consistent with the behaviour of `git diff`.
    difftool = true
    # 以下命令不使用core.pager / $PAGER浏览
    log = false
    branch = false
    tag = false
    reflog = false
    ; diff = false
    shortlog = false
    grep = false

# define command which will be used when "nvim" is set as a merge tool
[mergetool "nvim"]
    ; Be able to abort all diffs with `:cq` or `:cquit`
    trustExitCode = true
    ; layout = "(LOCAL,BASE,REMOTE)/MERGED"
    cmd = nvim -f -c \"Gvdiffsplit!\" \"$MERGED\"
[mergetool]
    # automatically launch merge tool without displaying a prompt
    prompt = false
    trustExitCode = true
    # 这样在解决冲突后就不会保留.orig文件了
    keepBackup = false
[merge]
    # set "nvim" as tool for merging
    tool = nvim
    conflictStyle = zdiff3

[rebase]
    # 在rebase -i 里自动将 之前commit --fixup A 产生的commit 放在 A 之后
    autosquash = true
    autoStash = true

[fetch]
    # fetch自动prune
    prune = true
[pull]
    # pull时用rebase="interactive"替代merge
    ; rebase = "interactive"
    rebase = true

[push]
    # push自动带上tags
    followTags = true

[commit]
    # 设置 commit 模板文件路径
    template = ~/.config/git/gitmessage

[credential]
    # 缓存HTTP/HTTPS方式输入的用户名密码时间, 设置为
    # 时间单位为秒 此处为大于100年
    helper = cache --timeout=360000000

# 自动解决重复冲突(比如reset后再次合并)
[rerere]
    enabled = true
    autoupdate = true

# }}}
