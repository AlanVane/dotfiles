; ~/.config/git/config
; NOTE: 1. alias不区分大小写
;       2. 和git-extras一起使用效果更佳
; FIXME: 在gitconfig里写的bash注意事项
; {{{  在gitconfig里写的bash注意事项
;           1. 应该用[ ] 而不是[[ ]], 不然会报错
;           2. 不能写#注释
;           3. 语句后面要写分号;
;           4. if [ -n  \"$abc\" ]; then 用-n或-z 判断字符串不为空/为空需要用双引号，不能不加引号或者是单引号
;           5. 双引号内一个 \ 就可以连接多行单命令语句了，用\\会转义空格的
;           6. 函数内不能用local
;       技巧：用多个'abc'$variable'abc'进行拼接字符串
;}}}

[include]
    path = ./conf/settings.gitconfig
    path = ./conf/aliases.gitconfig
    path = ./conf/colors.gitconfig
    path = ./conf/urls.gitconfig
    path = ./config.local

[http]
    postBuffer = 100000000
[ssh]
    postBuffer = 100000000

# 专为github设置的代理
[https "https://github.com"]
    proxy = socks5://127.0.0.1:20170
[https "https://android.googlesource.com"]
    proxy = socks5://127.0.0.1:20170

[user]
# Git用户配置（用户名和邮箱）
# 通常建议放在全局（--global），适用于你所有仓库，
# 但在特定项目需要不同身份时，再在项目内（不加 --global）覆盖设置，项目配置优先级高于全局，
# 这样既能保证日常开发一致性，又能灵活处理特殊项目（如公司内工作、开源项目）的身份切换.
    # github.com
    name = Alan.Shan
    email = apple.shan@gmail.com

[sendemail]
    smtpServer = smtp.gmail.com
    smtpServerPort = 587
    smtpEncryption = tls
    smtpUser = apple.shan@gmail.com
    # (Optional: we'll leave this commented out and use a different way)
    # smtpPass = PASSWORD
    # smtpPass should be placed in the config.local file.
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
[protocol "file"]
	allow = always
