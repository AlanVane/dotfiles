#########################################
###         KEY DEFINITIONS          ####
#########################################
##     $Mod = Super key or Mod4        ##
##         Mod1 = ALT key              ##
##       Control = CTRL key            ##
##        Shift = SHIFT key            ##
##       Escape = ESCAPE key           ##
##    Return = ENTER or RETURN key     ##
##        Pause = PAUSE key            ##
##        Print = PRINT key            ##
##          Tab = TAB key              ##
#########################################

# => 字体
# Font for window titles.
# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
font pango: DejaVu Sans Mono, FontAwesome 12

# => Super key ==  ⊞ Windows logo key  ==  Apple ⌘ Command key
set $super  Mod4

# Set default container layout for i3 (<default|stacking|tabbed>)
workspace_layout tabbed
# 自动切换到新打开的窗口 (smart|urgent|focus|none)
focus_on_window_activation smart

# 延迟工作区变化紧急提示重置
force_display_urgency_hint 2000 ms

# => 窗口边框类型（边框类型有 <normal(正常)|1pixel|pixel xx(自定义宽度)|none(无边框)|pixel>）
# 默认普通窗口的边框类型
new_window pixel 4
# 默认浮动窗口的边框类型
new_float normal
# 设置窗口边框隐藏 (none|vertical|horizontal|both|smart)
# hide_edge_borders both


###############################################################################
#  Application openners  
###############################################################################

# Open terminal (i3-sensible-terminal)
bindsym $super+Return  exec --no-startup-id  i3-sensible-terminal

# Start file manager (ranger、pcmanfm or thunar)
bindsym $super+F5  exec --no-startup-id  thunar

# Open web browser
bindsym $super+F3  exec --no-startup-id  google-chrome-stable

# flameshot 屏幕截图
bindsym Print  exec --no-startup-id  flameshot gui --delay 200

# flameshot config
bindsym $super+shift+Print  exec --no-startup-id  flameshot config

# soundcard mixer
bindsym $super+shift+Ctrl+m  exec --no-startup-id  alacritty -e 'alsamixer'


###############################################################################
#   Service Controls    
###############################################################################

# Rofi show applications
bindsym $super+d  exec --no-startup-id  rofi -show drun -columns 3

# Power Menu
# Repo: https://github.com/jluttine/rofi-power-menu
# No icons: https://github.com/jluttine/rofi-power-menu/issues/8#issuecomment-1440149437
bindsym $super+shift+p  exec --no-startup-id  $HOME/.config/rofi/scripts/rofi-power-menu/rofi-power-menu.sh

# 多媒体播放
bindsym $super+Ctrl+m  exec --no-startup-id  $HOME/.config/rofi/scripts/rofi-media/media.sh


###############################################################################
#   Misc keys          
###############################################################################

# Use rofi to search book on 'ebook' dir
bindsym $super+shift+b  exec --no-startup-id  $HOME/.config/rofi/scripts/rofi-book-selector/rofi-book-selector.sh

# xkill
# https://unix.stackexchange.com/questions/383065/execute-xkill-in-i3
bindsym --release $super+Ctrl+x  exec  xkill; exec notify-send 'Run xkill...'


###############################################################################
#   I3 conrols         
###############################################################################

# Rofi show window
bindsym $super+Tab  exec --no-startup-id  rofi -show window

# 当切换当前工作区时自动来回切换
workspace_auto_back_and_forth yes
# last activate workspace
bindsym $super+comma  workspace back_and_forth

# change focus(switch window in workspace)
## 在窗口之间导航焦点 // Window // <Super> ↑ ↓ ← → ##
bindsym $super+Left   focus left
bindsym $super+Down   focus down
bindsym $super+Up     focus up
bindsym $super+Right  focus right

# 绑定了 Redo 按键，它实际对应的是原右 ALT 按键
bindsym Mod1+Tab exec ~/.config/metaesc/restore_fullscreen.sh \
        && exec ~/.config/metaesc/focus_next_win.sh

# 移动窗口
# move focused window with cursor keys
## 移动聚焦的窗口 // Window // <Super><Shift> ↑ ↓ ← → ##
#bindsym $super+Shift+Left   move left
#bindsym $super+Shift+Down   move down
#bindsym $super+Shift+Up     move up
#bindsym $super+Shift+Right  move right

# 暂存窗口（额外的可隐藏浮动窗口，取消浮动还原成普通窗口）
## 转换普通窗口为暂存窗口 // Scratchpad // <Super><Shift> - ##
bindsym $super+Shift+minus  move scratchpad
## 呼出/隐藏暂存窗口 // Scratchpad // <Super> - ##
bindsym $super+minus  scratchpad show

# Resize panel 10x10 pixel
bindsym $super+Ctrl+shift+Left   resize shrink width 10 px or 10 ppt
bindsym $super+Ctrl+shift+Right  resize grow   width 10 px or 10 ppt
bindsym $super+Ctrl+shift+Up     resize shrink height 10 px or 10 ppt
bindsym $super+Ctrl+shift+Down   resize grow   height 10 px or 10 ppt

# Navigate workspaces next / previous
## 导航下一个/上一个工作区 // Window // <Super><Ctrl> ← → ##
bindsym $super+Ctrl+Left   workspace prev
bindsym $super+Ctrl+Right  workspace next

# => 布局切换 (change container layout <stacked, tabbed, toggle split>)

# Switch to stacked layout
## 切换到堆叠布局 // Window // <Super> s ##
#bindsym $super+s  layout stacking

# Switch to tabbed layout
## 切换到标签布局 // Window // <Super> w ##
#bindsym $super+w  layout tabbed

# Switch to tiled layout
## 切换到平铺布局（竖直/水平） // Window // <Super> e ##
#bindsym $super+e  layout toggle split

# Switch back and forth in all layouts <stacked, tabbed, toggle split>
## 在所有布局中轮回切换 // Window // <Super> x ##
bindsym $super+x  layout toggle all

# => fullscreen
# enter fullscreen mode for the focused container
## 窗口切换到全屏 // Window // <Super> f ##
bindsym $super+f  fullscreen toggle

# => float window setting
# Use Mouse+$super to drag floating windows to their wanted position
floating_modifier $super
# toggle tiling / floating
## 窗口切换到浮动 // Window // <Super><Shift><space> ##
bindsym $super+Shift+space  floating toggle
# floating_maximum_size 1200 x 900
floating_maximum_size -1 x -1

# toggle sticky
## 窗口切换为粘滞 // Window // <Super><Shift> s ##
#bindsym $super+Shift+s  sticky toggle

# => 焦点切换
# 焦点跟随鼠标移动 (change focus with cursor)
focus_follows_mouse yes
# 焦点切换到父窗口 (focus the parent container)
# bindsym $super+q focus parent
# 焦点切换回子窗口 (focus the child container)
# bindsym $super+z focus child
# 焦点切换到浮动窗口 (change focus between tiling / floating windows)
## 焦点切换到浮动窗口 // Window // <Super><space> ##
bindsym $super+space  focus mode_toggle

# => 新建窗口的分割方向
# Split window horizontally
## 水平分割视窗 // Workspace // <Super><Ctrl> h ##
#bindsym $super+Ctrl+h  split h;exec notify-send 'tile horizontally'
# Split window vertically
## 垂直分割窗口 // Workspace // <Super><Ctrl> v ##
#bindsym $super+Ctrl+v  split v;exec notify-send 'tile vertically'

## 在三种边框类型中切换 // Workspace // <Super> b ##
bindsym $super+b border toggle
# change borders
# bindsym $super+u  border none
# bindsym $super+y  border pixel 1
# bindsym $super+n  border normal

# => 设定工作区名 (workspace names)
# icons assigned by `polybar`
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
