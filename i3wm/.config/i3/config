bindsym $super+2  workspace $ws2, exec --no-startup-id ~/.local/bin/startup-app telegram-desktop
bindsym $super+3  workspace $ws3, exec --no-startup-id ~/.local/bin/startup-app google-chrome-stable
bindsym $super+4  workspace $ws4
bindsym $super+5  workspace $ws5, exec --no-startup-id ~/.local/bin/startup-app thunar
bindsym $super+6  workspace $ws6
bindsym $super+7  workspace $ws7
bindsym $super+8  workspace $ws8
bindsym $super+9  workspace $ws9
bindsym $super+0  workspace $ws0

# => 移动窗口到另一个工作区

# Move focused container to workspace
## 将聚焦的容器移动到另一个工作区 // Workspace // <Super><Ctrl> 1...0 ##
bindsym $super+Ctrl+1  move container to workspace $ws1
bindsym $super+Ctrl+2  move container to workspace $ws2
bindsym $super+Ctrl+3  move container to workspace $ws3
bindsym $super+Ctrl+4  move container to workspace $ws4
bindsym $super+Ctrl+5  move container to workspace $ws5
bindsym $super+Ctrl+6  move container to workspace $ws6
bindsym $super+Ctrl+7  move container to workspace $ws7
bindsym $super+Ctrl+8  move container to workspace $ws8
bindsym $super+Ctrl+9  move container to workspace $ws9
bindsym $super+Ctrl+0  move container to workspace $ws0

# Move to workspace with focused container
## 带上聚焦的容器移动到另一个工作区 // Workspace // <Super><Shift> 1...0 ##
bindsym $super+Shift+1  move container to workspace $ws1; workspace $ws1
bindsym $super+Shift+2  move container to workspace $ws2; workspace $ws2
bindsym $super+Shift+3  move container to workspace $ws3; workspace $ws3
bindsym $super+Shift+4  move container to workspace $ws4; workspace $ws4
bindsym $super+Shift+5  move container to workspace $ws5; workspace $ws5
bindsym $super+Shift+6  move container to workspace $ws6; workspace $ws6
bindsym $super+Shift+7  move container to workspace $ws7; workspace $ws7
bindsym $super+Shift+8  move container to workspace $ws8; workspace $ws8
bindsym $super+Shift+9  move container to workspace $ws9; workspace $ws9
bindsym $super+Shift+0  move container to workspace $ws0; workspace $ws0

# => 自动将窗口放到指定工作区（支持定义边框类型，窗口布局，大小调整，自动归类工作区等等，多个定义用,隔开）
# title 需要通过在终端执行 xprop，然后点击对应的 window, 
# 在显示信息中查找 _NET_WM_NAME 变量对应的名称，如果没有该变量，则匹配 WM_NAME 变量里的窗口名称
assign [class="org.wezfurlong.wezterm"] → number 1
assign [class="URxvt"] → number 2
assign [class="TelegramDesktop"] → number 2
assign [class="Google-chrome"] → number 3
assign [class="mpv"] → number 4
assign [class="Thunar"] → number 5
assign [class="Sublime_text"] → number 6
assign [class="Code"] → number 7
assign [class="Emacs"] → number 7
assign [class="Cc-switch"] → number 9

assign [class="org.remmina.Remmina"] → number 0
assign [class="Gnome-boxes"] → number 0
assign [class="VirtualBox Manager"] → number 0

assign [class="Arandr"] floating enable
assign [class="Nm-connection-editor"] floating enable
assign [class="Nm-applet"] floating enable
assign [title="PowerKit"] floating enable

# floating pop up automatically
assign [window_role="pop-up"] floating enable
assign [window_role="task_dialog"] floating enable

# => i3-gaps

# Set inner/outer gaps
set $default-gaps-inner 5
set $default-gaps-outer 5
gaps inner $default-gaps-inner
gaps outer $default-gaps-outer

# Smart gaps (gaps used if only more than one container on the workspace)
# smart_gaps on

# Smart borders (draw borders around container only if it is not the only container on this workspace)
# on|no_gaps (on=always activate and no_gaps=only activate if the gap size to the edge of the screen is 0)
smart_borders on

# adjust gaps on-the-fly
# Press $super+Shift+g to enter the gap mode.
# Choose o or i for modifying outer/inner gaps.
# Press one of + / - (in-/decrement for current workspace)
# or 0 (remove gaps for current workspace).
# If you also press Shift with these keys, the change will be global for all workspaces.
set $mode-gaps "Gaps: (o) outer, (i) inner"
set $mode-gaps-outer "Outer Gaps: +|-|0 (local), Shift + +|-|0 (global)"
set $mode-gaps-inner "Inner Gaps: +|-|0 (local), Shift + +|-|0 (global)"

mode $mode-gaps {
    bindsym o      mode $mode-gaps-outer
    bindsym i      mode $mode-gaps-inner

    bindsym 0      mode "default", exec --no-startup-id i3-msg "gaps inner current set 0" && i3-msg "gaps outer current set 0"
    bindsym d      mode "default", exec --no-startup-id i3-msg "gaps inner current set $default-gaps-inner" && i3-msg "gaps outer current set $default-gaps-outer"

    bindsym Escape mode default
}

mode $mode-gaps-inner {
    bindsym plus  gaps inner current plus 1
    bindsym minus gaps inner current minus 1
    bindsym 0     mode "default", gaps inner current set 0
    bindsym d     mode "default", gaps inner current set $default-gaps-inner

    bindsym Shift+plus  gaps inner all plus 1
    bindsym Shift+minus gaps inner all minus 1
    bindsym Shift+0     mode "default", gaps inner all set 0
    bindsym Shift+d     mode "default", gaps inner all set $default-gaps-inner

    bindsym Escape mode default
}

mode $mode-gaps-outer {
    bindsym plus  gaps outer current plus 1
    bindsym minus gaps outer current minus 1
    bindsym 0     mode "default", gaps outer current set 0
    bindsym d     mode "default", gaps outer current set $default-gaps-outer

    bindsym Shift+plus  gaps outer all plus 1
    bindsym Shift+minus gaps outer all minus 1
    bindsym Shift+0     mode "default", gaps outer all set 0
    bindsym Shift+d     mode "default", gaps outer all set $default-gaps-outer

    bindsym Escape mode default
}

# => kill focused window
## 关闭聚焦的窗口 // Window // <Super> q ##
set $close "Close the window? (y/n)"
mode $close {
    bindsym y kill, mode default
    bindsym Return kill, mode default
    bindsym q kill, mode default
    bindsym n mode default
    bindsym Escape mode default
}
bindsym $super+q mode $close

# => 调整窗口大小 (resize window with hjkl)
set $resize " resize h=shrink_5 j=grow_5 k=shrink_5 l=grow_5"
mode $resize {
    # these bindings trigger as soon as you enter the resize mode

    # pressing 'LEFT' or 'H' will shrink the window’s width.
    # pressing 'RIGHT' or 'L' will grow the window’s width.
    # pressing 'UP' or 'K' will shrink the window’s height.
    # pressing 'DOWN' or 'J' will grow the window’s height.
    bindsym Down   resize grow height 5 px or 5 ppt
    bindsym Up     resize shrink height 5 px or 5 ppt
    bindsym Right  resize grow width 5 px or 5 ppt
    bindsym Left   resize shrink width 5 px or 5 ppt
    bindsym j      resize grow height 5 px or 5 ppt
    bindsym k      resize shrink height 5 px or 5 ppt
    bindsym l      resize grow width 5 px or 5 ppt
    bindsym h      resize shrink width 5 px or 5 ppt

    bindsym 7 resize set 50 ppt 50 ppt
    bindsym 8 resize set 53 ppt 47 ppt
    bindsym 9 resize set 62 ppt 38 ppt

    # back to normal: Escape
    bindsym Escape mode default
}

# => 交换窗口 (swap window with shift hjkl)
set $swap-window "swap h=left j=down k=up l=right"
mode $swap-window {
    bindsym h move left
    bindsym j move down
    bindsym k move up
    bindsym l move right

    # back to normal: Escape
    bindsym Escape mode default
}

# => 修改工作区布局的子菜单
set $layout-mode "layout stack[s] tabbed[w] split[e] other toggle[o]"
mode $layout-mode {
    # change container layout <stacked, tabbed, toggle split>
    bindsym s layout stacking
    bindsym w layout tabbed
    bindsym e layout toggle split
    bindsym o layout toggle all

    # bindsym p focus parent
    # bindsym c focus child

    # 用 \ 切换左右布局 (split in horizontal orientation)
    bindsym backslash split h; exec notify-send " | split"
    # 用 - 切换为上下布局 (split in vertical orientation)
    bindsym minus split v; exec notify-send "-- split"

    # back to normal: Escape
    bindsym Escape mode default
}

# => 多屏切换
# New mode for switching monitor modes
set $monitorMode "monitor s=single, d=dual-screen"
mode $monitorMode {
    bindsym s  exec "~/.config/i3/screenlayout/single"
    bindsym d  exec "~/.config/i3/screenlayout/dual-screen"

    # back to normal: Escape
    bindsym Escape  mode default
}

set $volume-mode "Volume: Mute(F1), V-2(F2), V+2(F3), MicMute(F4)"
mode $volume-mode {
    bindsym F1 exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    bindsym F2 exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-
    bindsym F3 exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+
    bindsym F4 exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

    # back to normal: Escape
    bindsym Escape mode default
}

# => 切换键盘布局的子菜单（binding mode）
set $keymap-switch-mode "keymap: s(2), metaesc(1), default(0)"
mode $keymap-switch-mode {
    bindsym 0 exec ~/.config/metaesc/code01default.sh > /dev/null 2>&1, mode default
    bindsym 1 exec ~/.config/metaesc/code01s1.sh > /dev/null 2>&1, mode default
    bindsym 2 exec ~/.config/metaesc/code01s2.sh > /dev/null 2>&1, mode default

    # back to normal: Escape
    bindsym Escape mode default
}

set $main-mode "Menu swap/resize[hjkl,7,8,9] gaps[g] keymaps[k] layout[l] monitor[m] volume[v]"
mode $main-mode {
    bindsym g  mode $mode-gaps
    bindsym k  mode $keymap-switch-mode
    bindsym l  mode $layout-mode
    bindsym m  mode $monitorMode
    bindsym r  mode $resize
    bindsym s  mode $swap-window
    bindsym v  mode $volume-mode

    # => reload the configuration file（更改配置文件后只须重载即可生效，不包含自启部分）
    ## 重新载入 i3 配置 // i3 WM // <Super><Shift> c ##
    bindsym Shift+c  reload; exec notify-send 'Reload i3wm config'

    # restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
    ## 重启 i3 窗口管理器 // i3 WM // <Super><Shift> r ##
    bindsym Shift+r  restart; exec notify-send 'Restart i3wm'

    # back to normal: Escape
    bindsym Escape mode default
}

bindsym $super+semicolon  mode $main-mode

# => startup apps and daemons

# • exec命令
#   • exec 执行命令
#   • --no-startup-id 有些脚本或者程序不支持启动通知，不加命令，鼠标会长时间空转，60秒左右
#   • exec_always 每次重启i3，使用该命令启动的程序都会重新执行一次，不然只在开机时执行一次。

# `polybar` replaces `i3bar`
# more info at https://github.com/jaagr/polybar
# configuration in ~/.config/polybar/config.ini
exec_always --no-startup-id ~/.config/polybar/launch.sh

# => Copy/Paste 的统一
bindsym F8 --release exec ~/.config/metaesc/paste.sh c
bindsym F9 --release exec ~/.config/metaesc/paste.sh v

# => 更改键盘按键映射，增强 i3-wm 体验
