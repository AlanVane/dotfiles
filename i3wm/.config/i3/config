# => piper-speak
# https://github.com/appleshan/piper-speak
bindsym $super+Shift+s  exec --no-startup-id  speak-selection

bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

set $bright-note ~/.config/metaesc/brightness_code01.sh
bindsym XF86MonBrightnessUp exec $bright-note 20
bindsym XF86MonBrightnessDown exec $bright-note -20

# enable syntax highlighting in vim/neovim. must have the i3 plugin!
# get it at https://github.com/PotatoesMaster/i3-vim-syntax
# vim:filetype=i3
