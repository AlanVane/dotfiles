{
  "env": {
    "API_TIMEOUT_MS": "600000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet[1m]",
    "MAX_THINKING_TOKENS": "32000",
    "MCP_TIMEOUT": "60000"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "BashOutput",
      "Edit",
      "Glob",
      "Grep",
      "KillShell",
      "NotebookEdit",
      "Read",
      "SlashCommand",
      "Task",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__serena__list_dir"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/projects/ai-coding/claude-code-hooks/utils/event-logger.py"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/share/code-notify/lib/core/notifier.sh notification claude"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/projects/ai-coding/Claude-Code-Agent-Monitor/scripts/hook-handler.js\" Notification"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/projects/ai-coding/claude-code-hooks/utils/event-logger.py"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/projects/ai-coding/Claude-Code-Agent-Monitor/scripts/hook-handler.js\" PostToolUse"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python $HOME/projects/ai-coding/claude-code-hooks/utils/event-logger.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/projects/ai-coding/Claude-Code-Agent-Monitor/scripts/hook-handler.js\" PreToolUse"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/projects/ai-coding/Claude-Code-Agent-Monitor/scripts/hook-handler.js\" SessionEnd"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/projects/ai-coding/Claude-Code-Agent-Monitor/scripts/hook-handler.js\" SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/share/code-notify/lib/core/notifier.sh stop claude"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/projects/ai-coding/Claude-Code-Agent-Monitor/scripts/hook-handler.js\" Stop"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/share/code-notify/lib/core/notifier.sh SubagentStop claude"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/projects/ai-coding/Claude-Code-Agent-Monitor/scripts/hook-handler.js\" SubagentStop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/projects/ai-coding/Claude-Code-Agent-Monitor/scripts/hook-handler.js\" UserPromptSubmit"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "auto-stage@claude-code-hooks": true,
    "bounty-board@claude-code-hooks": true,
    "claude-code-wakatime@wakatime": true,
    "config-watch@claude-code-hooks": true,
    "context-hogs@claude-code-hooks": true,
    "dead-end-registry@claude-code-hooks": true,
    "dead-rules-audit@claude-code-hooks": true,
    "ecc@ecc": false,
    "format-code@claude-code-hooks": true,
    "guard-pack@claude-code-hooks": true,
    "nerf-receipts@claude-code-hooks": true,
    "session-logger@claude-code-hooks": true,
    "standup-autopilot@claude-code-hooks": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-hooks": {
      "source": {
        "source": "github",
        "repo": "karanb192/claude-code-hooks"
      }
    },
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    },
    "wakatime": {
      "source": {
        "source": "git",
        "url": "https://github.com/wakatime/claude-code-wakatime.git"
      }
    }
  },
  "outputStyle": "engineer-professional",
  "language": "Simplified Chinese",
  "alwaysThinkingEnabled": true,
  "editorMode": "vim",
  "disabledMcpServers": [
    "chrome-devtools",
    "nexus",
    "ito-compute",
    "jira",
    "github",
    "firecrawl",
    "supabase",
    "ecc-memory-vault",
    "omega-memory",
    "longhand",
    "vercel",
    "railway",
    "cloudflare-docs",
    "cloudflare-workers-builds",
    "cloudflare-workers-bindings",
    "cloudflare-observability",
    "clickhouse",
    "exa-web-search",
    "parallel-search",
    "context7",
    "codescene",
    "magic",
    "memxus",
    "filesystem",
    "playwright",
    "fal-ai",
    "browserbase",
    "browser-use",
    "devfleet",
    "token-optimizer",
    "laraplugins",
    "confluence",
    "evalview",
    "squish"
  ]
}
